                  {
                    "type": "text",
                    "value": "相乘取整法"
                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "hash(key) = ⌊m × (key × A % 1)⌋，关键字乘常数 A 后取小数部分再乘表长"
                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "对 A 的选择不敏感，几乎适用于所有关键字"
                  }
