        ]
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "二、tar 常用命令速查（补充）"
          }
        ],
        "data": {
          "headingId": "二tar-常用命令速查补充"
        }
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "压缩"
          }
        ],
        "data": {
          "headingId": "压缩"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 打包 + gzip 压缩\ntar czvf archive.tar.gz /path/to/dir\n\n# 打包 + bzip2 压缩（体积更小，更慢）\ntar cjvf archive.tar.bz2 /path/to/dir\n\n# 仅打包不压缩\ntar cvf archive.tar /path/to/dir"
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "解压"
          }
        ],
        "data": {
          "headingId": "解压"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 解压 .tar.gz\ntar xzvf archive.tar.gz\n\n# 解压 .tar.bz2\ntar xjvf archive.tar.bz2\n\n# 解压 .tar（自动识别格式）\ntar xvf archive.tar\n\n# 解压到指定目录\ntar xzvf archive.tar.gz -C /target/dir"
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "查看不解压"
          }
        ],
        "data": {
          "headingId": "查看不解压"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "tar tzvf archive.tar.gz"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "三、zip 常用命令速查（补充）"
          }
        ],
        "data": {
          "headingId": "三zip-常用命令速查补充"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 压缩\nzip -r archive.zip /path/to/dir\n\n# 解压\nunzip archive.zip\n\n# 解压到指定目录\nunzip archive.zip -d /target/dir\n\n# 查看内容\nunzip -l archive.zip"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "四、批量解压完整示例（补充）"
          }
        ],
        "data": {
          "headingId": "四批量解压完整示例补充"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 批量解压所有 .tar.gz\nfor f in *.tar.gz; do tar xzvf \"$f\"; done\n\n# 批量解压所有 .zip\nfor f in *.zip; do unzip -o \"$f\"; done"
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "⚠️ -o 覆盖已存在文件；脚本中使用 \"$f\" 引号防止文件名含空格出错。"
          }
        ]
      },
      {
        "type": "paragraph",
