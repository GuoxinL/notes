        "data": {
          "headingId": "二脚本中获取当前路径经典写法"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "CURRENT_DIR=\"$(cd \"$(dirname \"$0\")\"; pwd)\""
