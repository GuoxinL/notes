      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "原文采用双指针（i 从左、j 从右）+ 中间 pivot 的 Lomuto/Hoare 混合写法："
          }
        ]
      },
      {
        "type": "code",
        "lang": "go",
        "meta": null,
        "value": "func quickSort(arr []int, start, end int) {\n    if start < end {\n        i, j := start, end\n        key := arr[(start+end)/2]          // 取中间元素为 pivot\n        for i <= j {\n            for arr[i] < key {\n                i++                         // 左指针右移找 ≥ key\n            }\n            for arr[j] > key {\n                j--                         // 右指针左移找 ≤ key\n            }\n            if i <= j {\n                arr[i], arr[j] = arr[j], arr[i]\n                i++\n                j--\n            }\n        }\n        if start < j {\n            quickSort(arr, start, j)        // 递归排序左半\n        }\n        if end > i {\n            quickSort(arr, i, end)          // 递归排序右半\n        }\n    }\n}"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "七、常用优化"
