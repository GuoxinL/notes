      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 查看全部连接\nconntrack -L\n\n# 按状态统计\nconntrack -S\n\n# 查看表容量及使用率\ncat /proc/sys/net/netfilter/nf_conntrack_count\ncat /proc/sys/net/netfilter/nf_conntrack_max\n\n# 实时监控新连接数\nwatch -n1 'conntrack -L | wc -l'"
      },
