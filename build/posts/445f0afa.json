              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "存放对象实例与数组，GC 主战场；可按 -Xms/-Xmx 调整"
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "children": [
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "Metaspace（元空间）"
                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "Java 8 替代 PermGen，存放类元数据；本地内存（Native memory）"
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "children": [
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "└ Compressed Class Space（类压缩空间）"
                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "64 位下压缩指针存放类元数据，受 -XX:CompressedClassSpaceSize 限制"
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "children": [
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
