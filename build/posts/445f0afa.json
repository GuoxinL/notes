                "children": [
                  {
                    "type": "text",
                    "value": "每个类一份，存放编译期生成的字面量与符号引用"
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "children": [
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "代码缓存区（Code Cache）"
                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "JIT 编译后的本地代码，JVM 内部使用，受 -XX:ReservedCodeCacheSize 影响"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "线程私有区（每个线程一份）："
          }
        ]
      },
