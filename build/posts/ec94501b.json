                ]
              }
            ]
          },
          {
            "type": "listItem",
            "spread": false,
            "checked": null,
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "熔断状态机：关闭 → 打开（熔断）→ 半开（尝试恢复）"
                  }
                ]
              }
            ]
          }
        ]
      },
