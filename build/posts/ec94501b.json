                  }
                ]
              },
              {
                "type": "tableCell",
                "children": [
                  {
                    "type": "text",
                    "value": "不需协调其他服务部署；加快部署速度；支持 AB 测试；持续化部署成为可能"
                  }
                ]
              }
            ]
          },
