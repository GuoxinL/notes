      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "alias ls='ls --color=auto'\nalias ll='ls -alF'\nalias la='ls -A'\nalias grep='grep --color=auto'\nalias rm='rm -i'          # 删除前确认，防止误删\nalias cp='cp -i'\nalias mv='mv -i'"
      },
