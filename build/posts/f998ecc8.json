          }
        ],
        "data": {
          "headingId": "附录-ago-并发三件套速查"
        }
      },
      {
        "type": "code",
        "lang": "go",
        "meta": null,
        "value": "// 1. 启动 goroutine\ngo func() { /* ... */ }()\n\n// 2. 创建 channel\nch := make(chan int)       // 无缓冲（同步）\nch := make(chan int, 10)   // 有缓冲（容量 10）\n\n// 3. 通信\nch <- 42        // 发送\nv := <-ch      // 接收"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "附录 B：经典问答"
          }
