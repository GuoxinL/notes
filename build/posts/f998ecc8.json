          {
            "type": "listItem",
            "spread": false,
            "checked": null,
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "实体之间匿名（不感知对方身份），实现解耦"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "spread": false,
