      },
      {
        "type": "code",
        "lang": "c",
        "meta": null,
        "value": "for (int i = 0; i < n; i++)\n    for (int j = 1; j <= n; j++) {\n        c[i][j] = 0;\n        for (int k = 1; k <= n; k++)\n            c[i][j] = c[i][j] + a[i][k] * b[k][j];  // O(n³)\n    }"
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "求和推导："
          }
        ]
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "T(n) = Σᵢ₌₁ⁿ Σⱼ₌₁ⁿ Σₖ₌₁ⁿ 1 = Σᵢ₌₁ⁿ Σⱼ₌₁ⁿ n = Σᵢ₌₁ⁿ n² = n³ = O(n³)"
          }
        ]
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "案例 4：三角循环 → O(n³)"
