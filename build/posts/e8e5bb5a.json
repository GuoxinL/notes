        "data": {
          "headingId": "案例-2两层循环mn-omn"
        }
      },
      {
        "type": "code",
        "lang": "cpp",
        "meta": null,
        "value": "void exam(float x[][n], int m, int n) {\n    float sum[m];\n    for (int i = 0; i < m; i++) {\n        sum[i] = 0.0;\n        for (int j = 0; j < n; j++)\n            sum[i] += x[i][j];   // f(n) = m*n\n    }\n    for (int i = 0; i < m; i++)\n        cout << i << \":\" << sum[i] << endl;\n}"
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "基本语句频度 f(n) = m·n → O(m·n)。"
          }
        ]
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "案例 3：三重循环 → O(n³)"
