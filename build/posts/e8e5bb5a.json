      },
      {
        "type": "code",
        "lang": "c",
        "meta": null,
        "value": "for (int i = 1; i <= n; i++)\n    for (int j = 1; j <= i; j++)\n        for (int k = 1; k <= j; k++)\n            x = x + 1;"
      },
