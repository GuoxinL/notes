          {
            "type": "text",
            "value": "四、典型场景（补充）"
          }
        ],
        "data": {
          "headingId": "四典型场景补充"
        }
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 批量删除\nfind /tmp -name \"core.*\" | xargs rm -rf\n\n# 批量压缩\nfind . -name \"*.log\" | xargs -I {} gzip {}\n\n# 并行压缩（4 进程）\nfind . -name \"*.log\" | xargs -P4 -I {} gzip {}\n\n# 统计文本行数\nls *.txt | xargs wc -l\n\n# 多行转单行\ncat list.txt | xargs"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "五、xgrep 说明（补充）"
          }
        ],
        "data": {
          "headingId": "五xgrep-说明补充"
        }
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "xgrep 并非标准命令（无此工具）；通常实现\"递归 grep\"用："
          }
        ]
      },
      {
        "type": "code",
        "lang": "bash",
        "meta": null,
        "value": "# 递归搜索当前目录\ngrep -r \"关键字\" .\n\n# 按文件名过滤 + 内容搜索\nfind . -name \"*.go\" | xargs grep -l \"func main\""
      },
