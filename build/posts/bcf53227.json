      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "8.1 Apache Cloudberry"
          }
        ],
        "data": {
          "headingId": "81-apache-cloudberry"
        }
      },
      {
        "type": "list",
        "ordered": false,
        "start": null,
        "spread": false,
        "children": [
          {
            "type": "listItem",
            "spread": false,
            "checked": null,
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "开源云原生数据仓库，基于 Greenplum 演进，PostgreSQL 语法兼容，支持 MPP 大规模并行处理。"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
          {
            "type": "text",
            "value": "8.2 达梦数据库（DM）"
          }
        ],
        "data": {
          "headingId": "82-达梦数据库dm"
        }
      },
      {
        "type": "list",
        "ordered": false,
        "start": null,
        "spread": false,
        "children": [
          {
            "type": "listItem",
            "spread": false,
            "checked": null,
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "国产关系型数据库，兼容 Oracle/MySQL 语法，常用 SQL 引擎需支持：SQL 拆分、行为与权限分析、安全规则、系统函数与系统对象识别。"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "depth": 4,
        "children": [
