      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "现象：接口超时、单条 SQL 耗时 4~16 秒、"
          },
          {
            "type": "inlineCode",
            "value": "context canceled"
          },
          {
            "type": "text",
            "value": " 频发。"
          }
