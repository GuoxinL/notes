      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "核心索引（一次性执行）"
          }
        ],
        "data": {
          "headingId": "核心索引一次性执行"
        }
      },
      {
        "type": "code",
        "lang": "sql",
        "meta": null,
        "value": "-- ===== vc_issuer_log =====\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_vc_issuer_log_vc_id\nON vc_issuer_log(vc_id);\n\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_vc_issuer_log_holder\nON vc_issuer_log(holder);\n\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_vc_issuer_log_composite\nON vc_issuer_log(holder, issuer, vc_id, template_id);\n\n-- ===== did_document_record =====\n-- 每个 did 一般只有 3 行，单列索引完全够用，不需要联合索引\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_did_document_record_did\nON did_document_record(did);\n\n-- ===== identity_enterprise（部分索引，排除软删除）=====\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_identity_enterprise_uniscid_active\nON identity_enterprise(uniscid) WHERE deleted_at IS NULL;\n\nCREATE INDEX CONCURRENTLY IF NOT EXISTS idx_identity_enterprise_entname_active\nON identity_enterprise(entname) WHERE deleted_at IS NULL;\n\n-- ===== 更新统计信息 =====\nANALYZE vc_issuer_log;\nANALYZE did_document_record;\nANALYZE identity_enterprise;"
      },
      {
        "type": "blockquote",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "value": "版本差异\nKingbaseES V8R6+ 支持 "
              },
              {
                "type": "inlineCode",
                "value": "CONCURRENTLY"
              },
              {
                "type": "text",
                "value": " 与部分索引（"
              },
              {
                "type": "inlineCode",
                "value": "WHERE deleted_at IS NULL"
              },
              {
                "type": "text",
                "value": "）；老版本去掉这两个关键字即可。"
              }
            ]
          }
        ],
        "data": {
          "callout": "warning"
        }
      },
